# ══════════════════════════════════════════════════════════
# BLOOMS Junior School — Frontend Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is already in .gitignore — NEVER commit it.

# ── Database ─────────────────────────────────────────────
# Supabase PostgreSQL (default for development and production)
# Get this from your Supabase project settings
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# ── File Uploads ──────────────────────────────────────────
# Max upload size in bytes (default 10MB)
# UPLOAD_MAX_SIZE=10485760
